{
  "expo": {
    "name": "Aurum Preventa",
    "slug": "aurum-preventa",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ar.aurum.preventa"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B6E55",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ar.aurum.preventa"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Aurum Preventa usa la cámara para escanear el código de vinculación y los códigos de barras de los artículos.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "scheme": "aurumpreventa",
    "experiments": {
      "typedRoutes": true
    }
  }
}
